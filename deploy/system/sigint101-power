#!/bin/sh
# Self-locating launcher for the SIGINT 101 low-battery power watcher.
set -eu
LIB_DIR="$(dirname "$(readlink -f "$0")")/../lib/sigint101-power"
exec /usr/bin/python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); sys.argv = [sys.argv[0], *sys.argv[2:]]; from sigint101.power import main; sys.exit(main())' "$LIB_DIR" "$@"
