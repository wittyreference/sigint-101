+#ifndef WIN32
+static int loopback_endpoint(const struct sockaddr_in *addr, socklen_t length)
+{
+    return length == sizeof(*addr) && addr->sin_family == AF_INET &&
+           addr->sin_port != 0 && addr->sin_addr.s_addr == htonl(INADDR_LOOPBACK);
+}
+#endif
+
+int aisdecoder_use_udp_stdout(void)
+{
+#ifndef WIN32
+    int fd = STDOUT_FILENO;
+    int value;
+    socklen_t length = sizeof(value);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &value, &length) || value != SOCK_DGRAM)
+        return 0;
+#ifdef SO_PROTOCOL
+    length = sizeof(value);
+    if (getsockopt(fd, SOL_SOCKET, SO_PROTOCOL, &value, &length) || value != IPPROTO_UDP)
+        return 0;
+#endif
+    struct sockaddr_in endpoint;
+    length = sizeof(endpoint);
+    if (getsockname(fd, (struct sockaddr *)&endpoint, &length) ||
+        !loopback_endpoint(&endpoint, length))
+        return 0;
+    length = sizeof(endpoint);
+    if (getpeername(fd, (struct sockaddr *)&endpoint, &length) ||
+        !loopback_endpoint(&endpoint, length))
+        return 0;
+    udp_stdout = 1;
+#endif
+    return udp_stdout;
+}
+
+int aisdecoder_udp_failed(void)
+{
+    return atomic_load(&udp_failed);
+}
